# Studio 37 — environment variable template
# Copy to .env for local Netlify Dev; set the real values in the Netlify dashboard for production.
# DO NOT commit .env.

# Admin auth
# JWT_SECRET — REQUIRED. 32+ random chars. Used to sign admin session tokens.
JWT_SECRET=change-me-to-a-long-random-string-32plus-chars

# (Legacy) Shared admin password. As long as it's set, requests that send
# an `X-Admin-Key` header matching this value are accepted as a super admin
# fallback. Set LEGACY_ADMIN_KEY_FALLBACK=off (and unset ADMIN_KEY) to disable
# the fallback once every super user has set their own password.
ADMIN_KEY=
LEGACY_ADMIN_KEY_FALLBACK=on

# Twilio (SMS to Drew)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
DREW_PHONE=

# Resend (transactional emails). Blank optional values use the app defaults.
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
LEAD_NOTIFY_TO=
ORDER_NOTIFY_TO=

# Cloudflare Turnstile for quote requests. Set both keys to enable verification.
QUOTE_TURNSTILE_SITE_KEY=
QUOTE_TURNSTILE_SECRET_KEY=
# Optional comma-separated frontend hostnames; defaults to the production custom
# domain and its Netlify hostname. Use separate settings for local/preview deploys.
QUOTE_TURNSTILE_HOSTNAMES=

# Snipcart (legacy — fully removed; Snipcart is no longer used).
# Stripe Connect (Standard) replaces Snipcart + Square.

# Stripe — platform account secret + publishable keys.
# Get them at https://dashboard.stripe.com/apikeys (start with the sk_test_/pk_test_ pair).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook signing secrets — Stripe's new Workbench UI requires two separate
# event destinations because of v2 routing (platform events vs connected-account events).
#
# Destination 1: scope = "Connected accounts"
#   Events: checkout.session.completed, payment_intent.succeeded, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_xxx
#
# Destination 2: scope = "Your account"
#   Events: account.updated, account.application.deauthorized
STRIPE_WEBHOOK_SECRET_PLATFORM=whsec_xxx
# Optional: only needed if you switch to OAuth-style Connect onboarding.
STRIPE_CONNECT_CLIENT_ID=

# Tenant seed version — bump when products.seed.json or tenants.seed.json
# changes shape and you want a one-time re-seed pass.
TENANT_SEED_VERSION=1

# Cloudflare R2 (admin product image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=studio37-assets
R2_PUBLIC_BASE=https://assets.studio37customdesigns.com

# Public site URL (used for absolute links in SMS, etc.)
SITE_URL=https://studio37customdesigns.com

# Back Office (gilgameh) integration — see docs/backoffice-integration.md.
# Each flow is disabled until its secret is set; leave blank to turn it off.
BACKOFFICE_BASE_URL=https://gilgameh.netlify.app
BACKOFFICE_TENANT_SLUG=studio-37
# Back Office → Business, PDF & Security → Integration API Keys.
# Scopes: catalog:read catalog:write customers:read customers:write orders:read orders:write
BACKOFFICE_API_KEY=
# Back Office → Webhooks & Integrations → Website → webhookSecret (leads + orders in).
BACKOFFICE_WEBSITE_WEBHOOK_SECRET=
# Secret shown when registering https://studio37customdesigns.com/api/webhooks/backoffice
# in Back Office → Webhooks & Integrations (status updates out).
BACKOFFICE_OUTBOUND_WEBHOOK_SECRET=

# Storefront MCP endpoint (POST /api/mcp). 32+ random chars; blank = endpoint disabled (404).
STOREFRONT_MCP_TOKEN=
