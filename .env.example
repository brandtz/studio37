# Studio 37 — environment variable template
# Copy to .env for local Netlify Dev; set the real values in the Netlify dashboard for production.
# DO NOT commit .env.

# Admin auth
# JWT_SECRET — REQUIRED. 32+ random chars. Used to sign admin session tokens.
JWT_SECRET=change-me-to-a-long-random-string-32plus-chars

# (Legacy) Shared admin password. As long as it's set, requests that send
# an `X-Admin-Key` header matching this value are accepted as a super admin
# fallback. Set LEGACY_ADMIN_KEY_FALLBACK=off (and unset ADMIN_KEY) to disable
# the fallback once every super user has set their own password.
ADMIN_KEY=
LEGACY_ADMIN_KEY_FALLBACK=on

# Twilio (SMS to Drew)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
DREW_PHONE=

# Snipcart (legacy — fully removed; Snipcart is no longer used).
# Stripe Connect (Standard) replaces Snipcart + Square.

# Stripe — platform account secret + publishable keys.
# Get them at https://dashboard.stripe.com/apikeys (start with the sk_test_/pk_test_ pair).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook signing secret. Configure the endpoint at /api/stripe/webhook in
# the Stripe dashboard, subscribe to checkout.session.completed +
# payment_intent.* + account.updated, and **enable "Listen to events on
# Connected accounts."** Then paste the resulting whsec_… here.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional: only needed if you switch to OAuth-style Connect onboarding.
STRIPE_CONNECT_CLIENT_ID=

# Tenant seed version — bump when products.seed.json or tenants.seed.json
# changes shape and you want a one-time re-seed pass.
TENANT_SEED_VERSION=1

# Cloudflare R2 (admin product image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=studio37-assets
R2_PUBLIC_BASE=https://assets.studio37customdesigns.com

# Public site URL (used for absolute links in SMS, etc.)
SITE_URL=https://studio37customdesigns.com
